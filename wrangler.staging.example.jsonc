{
  // Review template only. Copy to ignored wrangler.staging.json after resources
  // are explicitly approved. Never use the production Worker name or bindings.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planflo-staging",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "rules": [{"type": "ESModule", "globs": ["**/*.js", "**/*.mjs"]}],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {"directory": "dist/client"},
  "d1_databases": [{"binding": "DB", "database_name": "planflo-staging-db", "database_id": "REPLACE_WITH_APPROVED_STAGING_ID", "migrations_dir": "drizzle"}],
  "r2_buckets": [{"binding": "FILES", "bucket_name": "planflo-staging-files"}],
  "services": [{"binding": "AUTH_EMAIL", "service": "planflo-staging-mail"}],
  "vars": {
    "PLANFLO_AUTH_MODE": "standalone",
    "PLANFLO_DEPLOYMENT": "staging",
    "PLANFLO_AUTH_ORIGIN": "https://REPLACE_WITH_APPROVED_STAGING_HOST"
  }
  // BETTER_AUTH_SECRET must be supplied through approved secret management.
  // Rob-only admin is disabled until both immutable ID and verified email are pinned.
}
