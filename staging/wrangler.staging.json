{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "planflo-staging",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "keep_vars": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "staging.planflo.app",
      "custom_domain": true,
      "zone_name": "planflo.app",
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "../dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planflo-staging-db",
      "database_id": "047774fa-ac31-45a1-b9a8-0144cc6c8e79",
      "migrations_dir": "../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "planflo-staging-files"
    }
  ],
  "services": [
    {
      "binding": "AUTH_EMAIL",
      "service": "planflo-staging-mail",
      "environment": "production"
    }
  ],
  "vars": {
    "PLANFLO_AUTH_MODE": "standalone",
    "PLANFLO_DEPLOYMENT": "staging",
    "PLANFLO_AUTH_ORIGIN": "https://staging.planflo.app"
  }
}
