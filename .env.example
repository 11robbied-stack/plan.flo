# Gmail invoice integration. Configure secrets in hosting, never in source control.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Base64-encoded 32 random bytes; retain this key while encrypted tokens exist.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Xero read-only payroll connection. Configure in hosting; never commit real values.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Base64-encoded 32 random bytes, separate from the Gmail key.
XERO_TOKEN_ENCRYPTION_KEY=

# Signup human verification (public site key + server-only secret).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
