{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "planflo-staging-mail",
  "main": "index.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": false},
  "vars": {
    "AUTH_EMAIL_PROVIDER": "resend",
    "AUTH_EMAIL_FROM": "no-reply@notifications.planflo.app",
    "PLANFLO_AUTH_ORIGIN": "https://staging.planflo.app"
  }
  // RESEND_API_KEY: Worker secret, never a repository variable.
}
