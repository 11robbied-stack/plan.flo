{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "planflo-staging-mail",
  "main": "index.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": false},
  "vars": {
    "AUTH_EMAIL_PROVIDER": "resend",
    "AUTH_EMAIL_FROM": "REPLACE_WITH_VERIFIED_SENDER",
    "PLANFLO_AUTH_ORIGIN": "https://REPLACE_WITH_APPROVED_STAGING_HOST"
  }
  // RESEND_API_KEY: Worker secret, never a repository variable.
}
